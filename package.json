{
  "name": "nagerx",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "install:all": "npm install",
    "build": "npm run build --workspace client",
    "test": "npm run test --workspace client",
    "start": "npm run start --workspace server",
    "dev": "npm run build && npm run start --workspace server",
    "dev:frontend": "concurrently \"npm run dev --workspace server\" \"npm run dev --workspace client\""
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  },
  "engines": {
    "node": ">=22 <25",
    "npm": ">=9"
  }
}
